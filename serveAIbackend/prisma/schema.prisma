datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  CHEF
  WAITER
  MANAGER 
}

model User {
  id String @id @default(uuid())
  name String
  email String @unique
  passwordHash String
  role Role @default(WAITER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}